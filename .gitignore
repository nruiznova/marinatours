# ==========================================
# ARCHIVOS DE CONFIGURACIÓN SENSIBLES
# ==========================================
# NOTA: Estos archivos YA fueron subidos una vez con las URLs
# Ahora Git ignorará cambios futuros (como contraseñas actualizadas)
# Para dejar de rastrear cambios futuros, ejecutar después del primer push:
# git update-index --assume-unchanged config.local.php
# git update-index --assume-unchanged config.prod.php

# Los archivos seguirán en el repo, pero Git ignorará modificaciones locales
config.local.php
config.prod.php
.env

# ==========================================
# ARCHIVOS DE DEBUG Y DESARROLLO
# ==========================================
# Archivos temporales solo para debug local
backend/ajax/debug_*.php
backend/ajax/diagnostico_*.php
backend/ajax/*_debug.ajax.php
backend/ajax/debug_reservas.log

# ==========================================
# LOGS Y ARCHIVOS TEMPORALES
# ==========================================
error_log
debug_reservas.log
*.log
*.tmp
*.cache
*.bak
*.swp
*~

# ==========================================
# DEPENDENCIAS Y VENDOR
# ==========================================
# Si usas Composer, no subir vendor (usar composer install en producción)
# extensiones/vendor/
# node_modules/

